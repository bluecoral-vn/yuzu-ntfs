      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support via Wise"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ủng hộ qua Wise"
          }
        }
      }
    },
    "The device is write-protected. Check its physical lock or image permissions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device is write-protected. Check its physical lock or image permissions."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị được bảo vệ chống ghi. Kiểm tra khóa vật lý hoặc quyền của tệp ảnh đĩa."
          }
        }
      }
    },
    "The drive is busy. Close files and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive is busy. Close files and try again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đĩa đang bận. Đóng các tệp rồi thử lại."
          }
        }
      }
    },
    "This NTFS format is unsupported. Use Windows to inspect the drive; there is no write override.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This NTFS format is unsupported. Use Windows to inspect the drive; there is no write override."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định dạng NTFS này chưa được hỗ trợ. Dùng Windows để kiểm tra ổ; không có tùy chọn ép ghi."
          }
        }
      }
    },
    "This drive was explicitly mounted read-only. Eject and reconnect it to apply your preference.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This drive was explicitly mounted read-only. Eject and reconnect it to apply your preference."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ này được gắn ở chế độ chỉ đọc. Tháo và kết nối lại để áp dụng tùy chọn của bạn."
          }
        }
      }
    },
    "This is experimental filesystem software. Sparse, compressed and encrypted files are not writable. An error can stop new writes, but already-mapped data can still change until eject. Keep backups and safely eject every drive.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is experimental filesystem software. Sparse, compressed and encrypted files are not writable. An error can stop new writes, but already-mapped data can still change until eject. Keep backups and safely eject every drive."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là phần mềm hệ thống tệp thử nghiệm. Không ghi được tệp thưa, nén hoặc mã hóa. Khi có lỗi, yêu cầu ghi mới có thể bị dừng nhưng dữ liệu đã ánh xạ vẫn có thể thay đổi trước khi tháo ổ. Hãy sao lưu và tháo ổ an toàn."
          }
        }
      }
    },
    "Unmounts and remounts this drive. Close open files first. Unsafe drives stay read-only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unmounts and remounts this drive. Close open files first. Unsafe drives stay read-only."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tháo và gắn lại ổ này. Hãy đóng tệp đang mở trước. Ổ không an toàn vẫn chỉ đọc."
          }
        }
      }
    },
    "Welcome to Yuzu NTFS": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Yuzu NTFS"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chào mừng đến với Yuzu NTFS"
          }
        }
      }
    },
    "Why read-only?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why read-only?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì sao chỉ đọc?"
          }
        }
      }
    },
    "Windows left this drive hibernated or in Fast Startup. In Windows, shut down while holding Shift, or turn off Fast Startup. Never delete hiberfil.sys to force writing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows left this drive hibernated or in Fast Startup. In Windows, shut down while holding Shift, or turn off Fast Startup. Never delete hiberfil.sys to force writing."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows để ổ ở trạng thái ngủ đông hoặc Khởi động nhanh. Trong Windows, giữ Shift khi tắt máy hoặc tắt Khởi động nhanh. Không xóa hiberfil.sys để ép ghi."
          }
        }
      }
    },
    "Windows marked this drive dirty. In Windows, run chkdsk /f on this drive, then safely eject it. Yuzu never repairs or clears the flag automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows marked this drive dirty. In Windows, run chkdsk /f on this drive, then safely eject it. Yuzu never repairs or clears the flag automatically."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows đánh dấu ổ chưa sạch. Trong Windows, chạy chkdsk /f cho ổ này rồi tháo an toàn. Yuzu không tự sửa hay xóa cờ lỗi."
          }
        }
      }
    },
    "Writing allowed (beta). Keep backups and eject before unplugging.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing allowed (beta). Keep backups and eject before unplugging."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã cho phép ghi (beta). Hãy sao lưu và tháo ổ trước khi rút cáp."
          }
        }
      }
    },
    "Writing is off for this drive. Enable Allow writing (beta) to opt in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing is off for this drive. Enable Allow writing (beta) to opt in."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chức năng ghi đang tắt cho ổ này. Bật Cho phép ghi (beta) để sử dụng."
          }
        }
      }
    },
    "Yuzu NTFS": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuzu NTFS"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuzu NTFS"
          }
        }
      }
    },
    "Yuzu enables only its own module and keeps a backup of the system preference. Eject all FSKit drives first. No reboot or reduced security is required.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuzu enables only its own module and keeps a backup of the system preference. Eject all FSKit drives first. No reboot or reduced security is required."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuzu chỉ bật mô-đun của mình và sao lưu tùy chọn hệ thống. Trước tiên hãy tháo tất cả ổ FSKit. Không cần khởi động lại hoặc giảm bảo mật."
          }
        }
      }
    },
    "yuzu.today": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "yuzu.today"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "yuzu.today"
          }
        }
      }
    }
  },
