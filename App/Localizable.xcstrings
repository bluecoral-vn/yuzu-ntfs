{
  "sourceLanguage": "en",
  "strings": {
    "Settings": {
      "localizations": { "vi": { "stringUnit": { "state": "translated", "value": "Cài đặt" } } }
    },
    "Settings…": {
      "localizations": { "vi": { "stringUnit": { "state": "translated", "value": "Cài đặt…" } } }
    },
    "Eject all Yuzu NTFS and other FSKit drives before quitting or updating.": {
      "localizations": { "vi": { "stringUnit": { "state": "translated", "value": "Tháo an toàn tất cả ổ Yuzu NTFS và FSKit khác trước khi thoát hoặc cập nhật." } } }
    },
    "Eject all FSKit drives, then enable Yuzu NTFS to finish updating the filesystem extension.": {
      "localizations": { "vi": { "stringUnit": { "state": "translated", "value": "Tháo an toàn tất cả ổ FSKit, sau đó bật Yuzu NTFS để hoàn tất cập nhật phần mở rộng hệ thống tập tin." } } }
    },
    "Check for Updates…": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Check for Updates…" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Kiểm tra bản cập nhật…" } }
      }
    },
    "Automatically check for updates": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Automatically check for updates" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Tự động kiểm tra bản cập nhật" } }
      }
    },
    "Eject drives before updating": {
      "localizations": {
        "vi": { "stringUnit": { "state": "translated", "value": "Tháo ổ đĩa trước khi cập nhật" } }
      }
    },
    "Eject all Yuzu NTFS and other FSKit drives to install the update. Installation will resume automatically after ejecting.": {
      "localizations": {
        "vi": { "stringUnit": { "state": "translated", "value": "Tháo an toàn tất cả ổ Yuzu NTFS và FSKit khác để cài bản cập nhật. Quá trình cài đặt sẽ tự tiếp tục sau khi tháo ổ." } }
      }
    },
    "%@ free of %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ free of %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn trống %@ trên %@"
          }
        }
      }
    },
    "0.1.0 Beta": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0.1.0 Beta"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "0.1.0 Beta"
          }
        }
      }
    },
    "0.1.0 Beta (2)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0.1.0 Beta (2)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "0.1.0 Beta (2)"
          }
        }
      }
    },
    "0.1.0 Beta · Apple silicon · macOS 26+": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0.1.0 Beta · Apple silicon · macOS 26+"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "0.1.0 Beta · Apple silicon · macOS 26+"
          }
        }
      }
    },
    "A filesystem error stopped new writes. Eject the drive and check it with chkdsk in Windows. Already-mapped data can still change until eject (beta limitation M-R1).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A filesystem error stopped new writes. Eject the drive and check it with chkdsk in Windows. Already-mapped data can still change until eject (beta limitation M-R1)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lỗi hệ thống tệp đã dừng các yêu cầu ghi mới. Tháo ổ đĩa rồi kiểm tra bằng chkdsk trong Windows. Dữ liệu đã được ánh xạ vẫn có thể thay đổi trước khi tháo ổ (giới hạn beta M-R1)."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giới thiệu"
          }
        }
      }
    },
    "Accept the beta backup acknowledgement before allowing writing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept the beta backup acknowledgement before allowing writing."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy xác nhận lưu ý sao lưu bản beta trước khi cho phép ghi."
          }
        }
      }
    },
    "Allow writing (beta)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow writing (beta)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép ghi (beta)"
          }
        }
      }
    },
    "Backup notice accepted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup notice accepted"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xác nhận lưu ý sao lưu"
          }
        }
      }
    },
    "Beta — keep a backup of data you can't replace": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beta — keep a backup of data you can't replace"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản beta — hãy sao lưu dữ liệu không thể thay thế"
          }
        }
      }
    },
    "Encrypted with BitLocker — not supported. Unlock and decrypt the drive in Windows; Yuzu cannot mount or write it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted with BitLocker — not supported. Unlock and decrypt the drive in Windows; Yuzu cannot mount or write it."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ được mã hóa BitLocker — không được hỗ trợ. Hãy mở khóa và giải mã ổ trong Windows; Yuzu không thể gắn hay ghi vào ổ này."
          }
        }
      }
    },
    "Disable Yuzu NTFS": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable Yuzu NTFS"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt Yuzu NTFS"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong"
          }
        }
      }
    },
    "Drive is read-only": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive is read-only"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đĩa chỉ đọc"
