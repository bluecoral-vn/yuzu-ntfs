          }
        }
      }
    },
    "Open System Settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Cài đặt hệ thống"
          }
        }
      }
    },
    "Plug in an NTFS drive. It starts read-only. In the menu bar, turn on Allow writing (beta) for each drive you trust. Hibernated or dirty drives always stay read-only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plug in an NTFS drive. It starts read-only. In the menu bar, turn on Allow writing (beta) for each drive you trust. Hibernated or dirty drives always stay read-only."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối ổ NTFS. Ban đầu ổ chỉ đọc. Trong thanh menu, bật Cho phép ghi (beta) cho từng ổ bạn tin tưởng. Ổ đang ngủ đông hoặc có cờ lỗi luôn chỉ đọc."
          }
        }
      }
    },
    "Plug in an NTFS drive. Writing is off until you opt in for that drive.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plug in an NTFS drive. Writing is off until you opt in for that drive."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối ổ NTFS. Chức năng ghi tắt cho đến khi bạn cho phép riêng cho ổ đó."
          }
        }
      }
    },
    "Quit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
