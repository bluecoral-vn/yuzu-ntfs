        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tháo ổ đĩa"
          }
        }
      }
    },
    "Eject all FSKit drives before disabling. Quitting does not disable the extension.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eject all FSKit drives before disabling. Quitting does not disable the extension."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tháo tất cả ổ FSKit trước khi tắt. Thoát ứng dụng không tắt tiện ích hệ thống tệp."
          }
        }
      }
    },
    "Eject all FSKit drives before enabling or disabling Yuzu NTFS.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eject all FSKit drives before enabling or disabling Yuzu NTFS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tháo tất cả ổ FSKit trước khi bật hoặc tắt Yuzu NTFS."
          }
        }
      }
    },
    "Enable Yuzu NTFS": {
      "localizations": {
