    "No NTFS drives": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No NTFS drives"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có ổ NTFS"
          }
        }
      }
    },
    "No telemetry. Diagnostics are exported only when you choose. Updates are manual for this beta.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No telemetry. Diagnostics are exported only when you choose. Updates are manual for this beta."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thu thập dữ liệu sử dụng. Chỉ xuất chẩn đoán khi bạn yêu cầu. Bản beta này cần cập nhật thủ công."
          }
        }
      }
    },
    "On macOS 26: System Settings → General → Login Items & Extensions → File System Extensions. If the toggle does not work, use Enable Yuzu NTFS above.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On macOS 26: System Settings → General → Login Items & Extensions → File System Extensions. If the toggle does not work, use Enable Yuzu NTFS above."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên macOS 26: Cài đặt hệ thống → Cài đặt chung → Mục đăng nhập & Tiện ích → Tiện ích hệ thống tệp. Nếu công tắc không hoạt động, dùng nút Bật Yuzu NTFS ở trên."
          }
        }
      }
    },
    "Open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        },
        "vi": {
